{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1200px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "palette": [
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#0B1220"
    },
    {
     "slug": "navy",
     "name": "Navy",
     "color": "#142034"
    },
    {
     "slug": "slate",
     "name": "Slate",
     "color": "#1F2937"
    },
    {
     "slug": "steel",
     "name": "Steel Blue",
     "color": "#547590"
    },
    {
     "slug": "green",
     "name": "Yroc Green",
     "color": "#7ED957"
    },
    {
     "slug": "green-dark",
     "name": "Green Dark",
     "color": "#3F8F1C"
    },
    {
     "slug": "blue",
     "name": "Signal Blue",
     "color": "#0099FF"
    },
    {
     "slug": "text",
     "name": "Text",
     "color": "#3B4556"
    },
    {
     "slug": "muted",
     "name": "Muted",
     "color": "#6B7280"
    },
    {
     "slug": "line",
     "name": "Line",
     "color": "#E3E7ED"
    },
    {
     "slug": "light",
     "name": "Light",
     "color": "#F6F7F9"
    },
    {
     "slug": "white",
     "name": "White",
     "color": "#FFFFFF"
    }
   ],
   "gradients": [
    {
     "slug": "night",
     "name": "Night",
     "gradient": "linear-gradient(135deg,#0B1220 0%,#142034 55%,#1F2937 100%)"
    },
    {
     "slug": "brand",
     "name": "Brand",
     "gradient": "linear-gradient(135deg,#7ED957 0%,#0099FF 100%)"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "fluid": true,
   "fontFamilies": [
    {
     "slug": "poppins",
     "name": "Poppins",
     "fontFamily": "Poppins, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
     "fontFace": [
      {
       "fontFamily": "Poppins",
       "fontWeight": "400",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/poppins-latin-400-normal.woff2"
       ]
      },
      {
       "fontFamily": "Poppins",
       "fontWeight": "500",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/poppins-latin-500-normal.woff2"
       ]
      },
      {
       "fontFamily": "Poppins",
       "fontWeight": "600",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/poppins-latin-600-normal.woff2"
       ]
      },
      {
       "fontFamily": "Poppins",
       "fontWeight": "700",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/poppins-latin-700-normal.woff2"
       ]
      },
      {
       "fontFamily": "Poppins",
       "fontWeight": "800",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/poppins-latin-800-normal.woff2"
       ]
      }
     ]
    },
    {
     "slug": "serif",
     "name": "Instrument Serif",
     "fontFamily": "'Instrument Serif', Georgia, serif",
     "fontFace": [
      {
       "fontFamily": "Instrument Serif",
       "fontWeight": "400",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-serif-latin-400-normal.woff2"
       ]
      },
      {
       "fontFamily": "Instrument Serif",
       "fontWeight": "400",
       "fontStyle": "italic",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/instrument-serif-latin-400-italic.woff2"
       ]
      }
     ]
    },
    {
     "slug": "mono",
     "name": "JetBrains Mono",
     "fontFamily": "'JetBrains Mono', ui-monospace, monospace",
     "fontFace": [
      {
       "fontFamily": "JetBrains Mono",
       "fontWeight": "400",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/jetbrains-mono-latin-400-normal.woff2"
       ]
      },
      {
       "fontFamily": "JetBrains Mono",
       "fontWeight": "600",
       "fontStyle": "normal",
       "fontDisplay": "swap",
       "src": [
        "file:./assets/fonts/jetbrains-mono-latin-600-normal.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem",
     "fluid": false
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "1.25rem",
     "fluid": {
      "min": "1.125rem",
      "max": "1.25rem"
     }
    },
    {
     "slug": "x-large",
     "name": "XL",
     "size": "2rem",
     "fluid": {
      "min": "1.6rem",
      "max": "2.25rem"
     }
    },
    {
     "slug": "xx-large",
     "name": "XXL",
     "size": "3.25rem",
     "fluid": {
      "min": "2.3rem",
      "max": "3.75rem"
     }
    }
   ]
  },
  "spacing": {
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ]
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--white)",
   "text": "var(--wp--preset--color--text)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--poppins)",
   "fontSize": "var(--wp--preset--font-size--medium)",
   "lineHeight": "1.7"
  },
  "spacing": {
   "padding": {
    "left": "clamp(16px,4vw,32px)",
    "right": "clamp(16px,4vw,32px)"
   },
   "blockGap": "1.25rem"
  },
  "elements": {
   "heading": {
    "color": {
     "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
     "fontWeight": "700",
     "lineHeight": "1.15",
     "letterSpacing": "-0.03em"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xx-large)"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--x-large)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--large)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--green-dark)"
    },
    ":hover": {
     "color": {
      "text": "var(--wp--preset--color--blue)"
     }
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--ink)",
     "text": "var(--wp--preset--color--white)"
    },
    "typography": {
     "fontWeight": "600",
     "fontSize": "1rem"
    },
    "border": {
     "radius": "12px"
    },
    "spacing": {
     "padding": {
      "top": "0.85rem",
      "bottom": "0.85rem",
      "left": "1.6rem",
      "right": "1.6rem"
     }
    },
    ":hover": {
     "color": {
      "background": "var(--wp--preset--color--ink)",
      "text": "var(--wp--preset--color--white)"
     }
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-landing",
   "title": "Landing (full width, no title)",
   "postTypes": [
    "page"
   ]
  }
 ]
}